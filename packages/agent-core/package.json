{
  "name": "@einfach-agent/core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allroad88888888/einfach-agent.git",
    "directory": "packages/agent-core"
  },
  "type": "module",
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./timeline": {
      "types": "./dist/timeline.d.ts",
      "default": "./dist/timeline.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.js"
    },
    "./subagents": {
      "types": "./dist/subagents/index.d.ts",
      "default": "./dist/subagents/index.js"
    },
    "./state/persistence": {
      "types": "./dist/state/persistence/index.d.ts",
      "default": "./dist/state/persistence/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "default": "./dist/observability/index.js"
    },
    "./skills": {
      "types": "./dist/skills/index.d.ts",
      "default": "./dist/skills/index.js"
    },
    "./planning": {
      "types": "./dist/planning/index.d.ts",
      "default": "./dist/planning/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node ../../scripts/fix-dts-specifiers.mjs dist"
  },
  "dependencies": {
    "@einfach-agent/ai": "workspace:*",
    "@einfach/core": "^0.4.0"
  },
  "devDependencies": {
    "vitest": "^4.0.15"
  }
}
