{
  "name": "@web-agent/subagents",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allroad88888888/einfach-agent.git",
    "directory": "packages/subagents"
  },
  "type": "module",
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./archive/replay": {
      "types": "./dist/archive/replay.d.ts",
      "default": "./dist/archive/replay.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node ../../scripts/fix-dts-specifiers.mjs dist"
  },
  "dependencies": {
    "@einfach/core": "^0.2.18",
    "@web-agent/ai": "workspace:*",
    "@web-agent/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.0.15"
  }
}
