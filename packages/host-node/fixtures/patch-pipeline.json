    {
      "name": "a stale content hash is rejected and nothing lands on disk",
      "source": "workspace_patch_guard_tests.rs::overwrite_rejects_a_stale_content_hash",
      "initialFiles": { "code.txt": "current\n" },
      "operations": [
        {
          "type": "overwrite_file",
          "path": "code.txt",
          "content": "new\n",
          "expectedContentHash": "sha256:a9b004fb029473f2b5fc51a6ed7411ca8dd55e6bc3be897ff56da17b257ea535"
        }
      ],
      "dryRun": false,
      "expected": {
        "result": {
          "ok": false,
          "changedFiles": [],
          "changes": [],
          "rejected": [
            {
              "index": 0,
              "operation": "overwrite_file",
              "path": "code.txt",
              "reason": "expectedContentHash did not match current file content; re-read the file and retry with the new contentHash"
            }
          ],
          "dryRun": false,
          "wouldChange": false,
          "summary": "rejected 1 operation(s); no files changed",
          "changeSet": null
        },
        "files": { "code.txt": "current\n" }
      }
    },
    {
