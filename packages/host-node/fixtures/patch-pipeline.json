{
  "target": "apply_workspace_patch_blocking_with_journal / applyPatch —— 整条补丁流水线：初始文件树 + 操作 → 完整回执 JSON + 落盘后的树",
  "cases": [
    {
      "name": "result reports per-file change summaries",
      "source": "workspace_patch_pipeline_tests.rs::result_reports_per_file_change_summaries",
      "initialFiles": { "edit.txt": "keep\nold\n", "gone.txt": "bye\n" },
      "operations": [
        { "type": "add_file", "path": "fresh.txt", "content": "one\ntwo\n" },
        { "type": "overwrite_file", "path": "edit.txt", "content": "keep\nnew\n", "oldContent": "keep\nold\n" },
        { "type": "delete_file", "path": "gone.txt" }
      ],
      "dryRun": false,
      "expected": {
        "result": {
          "ok": true,
          "changedFiles": ["edit.txt", "fresh.txt", "gone.txt"],
          "changes": [
            {
              "path": "edit.txt",
              "created": false,
              "deleted": false,
              "changeSummary": {
                "linesAdded": 1,
                "linesRemoved": 1,
                "beforeLines": 2,
                "afterLines": 2,
                "diff": "@@ -2,1 +2,1 @@\n-old\n+new",
                "diffTruncated": false,
                "approximate": false
              }
            },
            {
              "path": "fresh.txt",
              "created": true,
              "deleted": false,
              "changeSummary": {
                "linesAdded": 2,
                "linesRemoved": 0,
                "beforeLines": 0,
                "afterLines": 2,
                "diff": "@@ -1,0 +1,2 @@\n+one\n+two",
                "diffTruncated": false,
                "approximate": false
              }
            },
            { "path": "gone.txt", "created": false, "deleted": true }
          ],
          "rejected": [],
          "dryRun": false,
          "wouldChange": true,
          "summary": "applied patch: 3 file(s) changed",
          "changeSet": null
        },
        "files": { "edit.txt": "keep\nnew\n", "fresh.txt": "one\ntwo\n" }
      }
    },
    {
      "name": "executable bit applies within the transaction",
      "source": "workspace_patch_pipeline_tests.rs::executable_bit_applies_within_the_transaction",
      "unixOnly": true,
      "initialFiles": {},
      "operations": [
        { "type": "add_file", "path": "run.sh", "content": "#!/bin/sh\n", "executable": true }
      ],
      "dryRun": false,
      "expected": {
        "result": {
          "ok": true,
          "changedFiles": ["run.sh"],
          "changes": [
            {
              "path": "run.sh",
              "created": true,
              "deleted": false,
              "changeSummary": {
                "linesAdded": 1,
                "linesRemoved": 0,
                "beforeLines": 0,
                "afterLines": 1,
                "diff": "@@ -1,0 +1,1 @@\n+#!/bin/sh",
                "diffTruncated": false,
                "approximate": false
              }
            }
          ],
          "rejected": [],
          "dryRun": false,
          "wouldChange": true,
          "summary": "applied patch: 1 file(s) changed",
          "changeSet": null
        },
        "files": { "run.sh": "#!/bin/sh\n" },
        "executable": { "run.sh": true }
      }
    },
