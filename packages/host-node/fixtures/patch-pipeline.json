    {
      "name": "a successful journaled patch returns the persisted change set",
      "source": "workspace_patch_pipeline_tests.rs::successful_patch_returns_persisted_change_set",
      "initialFiles": { "code.txt": "before" },
      "operations": [
        { "type": "replace", "path": "code.txt", "oldText": "before", "newText": "after" }
      ],
      "dryRun": false,
      "changeContext": {
        "changeId": "patch-change",
        "sessionId": "session",
        "runId": "run",
        "toolCallId": "call"
      },
      "expected": {
        "result": {
          "ok": true,
          "changedFiles": ["code.txt"],
          "changes": [
            {
              "path": "code.txt",
              "created": false,
              "deleted": false,
              "changeSummary": {
                "linesAdded": 1,
                "linesRemoved": 1,
                "beforeLines": 1,
                "afterLines": 1,
                "diff": "@@ -1,1 +1,1 @@\n-before\n+after",
                "diffTruncated": false,
                "approximate": false
              }
            }
          ],
          "rejected": [],
          "dryRun": false,
          "wouldChange": true,
          "summary": "applied patch: 1 file(s) changed",
          "changeSet": { "id": "patch-change", "reversible": true }
        },
        "files": { "code.txt": "after" },
        "journalEntries": { "patch-change": "applied" }
      }
    },
