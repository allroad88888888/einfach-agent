      "dryRun": false,
      "expected": {
        "result": {
          "ok": false,
          "changedFiles": [],
          "changes": [],
          "rejected": [
            { "index": 1, "operation": "add_file", "path": "a.txt", "reason": "file already exists" }
          ],
          "dryRun": false,
          "wouldChange": false,
          "summary": "rejected 1 operation(s); no files changed",
          "changeSet": null
        },
        "files": { "a.txt": "A\n" }
      }
    },
