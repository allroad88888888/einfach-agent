{
  "name": "@web-agent/react-plugin",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allroad88888888/einfach-agent.git",
    "directory": "packages/agent-react"
  },
  "type": "module",
  "files": ["dist"],
  "publishConfig": {
