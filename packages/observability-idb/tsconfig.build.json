// 声明产物专用 tsconfig：只出 .d.ts，JS 由 tsup 出（见 tsup.config.ts 与根 tsup.preset.ts）。
// V3b 逐包接线：骨架复制自 packages/agent-core/tsconfig.build.json（拓扑根卡 V3a 落地时写下的
// 样板），但 `paths` 这一项按下面的实测结果做了必要调整——不是照抄 `"paths": {}`。
//
// 为什么不能照抄空 paths：core 的 package.json 只给 9 条公开 subpath 配了
// `{types, default}` 指向 dist，其余深路径靠 `"./*": "./src/*"` 兜底（S10 仍 GATED，未改）。
// 这条通配把目标写成不带扩展名的 `./src/<segment>`，而 Node/TS 的 exports 通配解析要求目标
// 字面存在（不会像相对导入那样自动试探 `.ts`/`.d.ts` 扩展名）——`./src/state/core.type` 这个
// 路径本身并不存在（磁盘上是 `core.type.ts`），于是任何未在白名单里的深路径在真实 exports
// 解析下一律 TS2307/"Export specifier ... does not exist"（用 `tsc --traceResolution` 实测
// 复现，`state/core.type`、`runtime/hostPlatform`、`execution/graph` 等均命中，非个例）。
// 本包源码里恰好有若干这类深路径引用（多数属于 check-boundaries.js 的 S9 白名单豁免项，
// 即已知未收敛、暂缓的既有引用面），若沿用空 paths 会导致 `tsc -p tsconfig.build.json`
// 对本包 100% 失败，`pnpm -r build` 无法全绿。
// 解法：**清空继承来的 paths 后，只补一条指向 core dist 的显式映射**（而不是让它落回
// node_modules 解析）——`@einfach-agent/core` 与 `@einfach-agent/core/*` 都直接指到
// `packages/agent-core/dist` 下的同名路径。dist 是 tsc 对 core `src` 全量做
// `emitDeclarationOnly` 的产物（不受 tsup 九条 entry 限制，`src` 下每个非测试文件都有对应
// `.d.ts`），所以这条映射能覆盖白名单内外的全部深路径，且解析目标是声明文件、不受 rootDir
// 限制，不会重犯 TS6059。
// **代价与边界**：这只解决了「本包自己声明 emit 时能找到 core 的类型」这一步（满足
// `pnpm -r build` 判据）；它不改变**发布出去的 .d.ts 里那条裸说明符**——fix-dts-specifiers
// 只改相对说明符，`@einfach-agent/core/state/core.type` 这类裸说明符原样保留。真实 npm 消费方
// 装包后用自己的 node_modules 解析这条说明符，仍会撞上 core 的 `./*` 通配同一个问题——这是
// core 公开面还没收敛到「深路径全部落地为具名 subpath」的已知缺口（S10 GATED、S9 白名单里
// 也记着这些具体引用点），修复归属 core 自己的公开面收敛树，不是 V3b 的改动面。
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // 包平时的 tsconfig.json 是 noEmit 的纯类型门禁，这里翻开只为 emit 声明。
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    // 不出 declaration map：发布物 `files: ["dist"]` 不含 src，map 只会指向不存在的路径。
    "declarationMap": false,
    // 不能开 incremental/composite：tsup 的 clean 会先清空 dist，而 buildinfo 只看源码变没变，
    // 于是「源码没改 + dist 被清空」会让 tsc 直接跳过 emit，产出一个没有 .d.ts 的 dist。
    "incremental": false,
    "composite": false,
    // 清空继承来的 paths（tsconfig.app.json 把 `@einfach-agent/*` 指向各包**源码**），只留一条
    // 显式补丁：`@einfach-agent/core`/`@einfach-agent/core/*` 直接指向 core 的 dist 声明产物。
    // 理由见文件头长注释——core 的 package.json exports 通配对深路径不可靠，直接点 dist
    // 比"清空后指望 node_modules 解析"更稳。**前提同样是 core 已按拓扑序先出 dist**；
    // core 还没构建时这里会变成一片 TS2307/TS6059。
    "paths": {
      "@einfach-agent/core": ["packages/agent-core/dist/index.d.ts"],
      "@einfach-agent/core/*": ["packages/agent-core/dist/*"]
    },
    // pnpm 的 node_modules 是符号链接，TS 默认会 realpath 到 `node_modules/.pnpm/<pkg>@<ver>/...`；
    // 给推断出来的类型起名时它就写不出可移植的说明符，报 TS2742
    // 「cannot be named without a reference to '.pnpm/@einfach+core@…'」（core 卡实测三处返回值
    // 带跨包 Store 类型的导出函数）。关掉 realpath 后，TS 认 `node_modules/<dep>` 这条真实存在的
    // 依赖路径，声明里就是裸说明符。
    // 只影响这份「声明 emit 专用」配置：日常类型门禁（tsconfig.json）、Vite/Vitest 都不读它。
    "preserveSymlinks": true,
    // 不可省：缺了 rootDir，TS 会把公共根推断到仓库根，产物变成 dist/packages/<pkg>/... 或
    // dist/tools/<pkg>/...，并把跨包源码一起漏进 dist，而 fix-dts-specifiers 对这种畸形 dist
    // 不会报错（它只查说明符解析得到与否），错误会一路静默到发布。
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src"],
  // 测试与测试脚手架不进发布物（口径同 scripts/check-boundaries.js 的 testFilePattern）。
  "exclude": ["src/**/*.test.ts", "src/**/*.testFixtures.ts", "src/**/*.testHarness.ts"]
}
