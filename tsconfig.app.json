{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@web-agent/ai": ["packages/agent-ai/src/index.ts"],
      "@web-agent/core/*": ["packages/agent-core/src/*"],
      "@web-agent/tools": ["packages/tools/src/index.ts"],
      "@web-agent/tools-shell": ["packages/tools-shell/src/index.ts"],
      "@web-agent/tools-interaction": ["packages/tools-interaction/src/index.ts"],
      "@web-agent/tools-fs": ["packages/tools-fs/src/index.ts"],
      "@web-agent/tools-planning": ["packages/tools-planning/src/index.ts"],
      "@web-agent/tools-skills": ["packages/tools-skills/src/index.ts"],
      "@web-agent/tools-agents": ["packages/tools-agents/src/index.ts"]
    }
  },
  "include": ["src", "packages/*/src"]
}
