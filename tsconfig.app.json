{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/web/src/*"],
      "@einfach-agent/ai": ["packages/agent-ai/src/index.ts"],
      "@einfach-agent/core": ["packages/agent-core/src/index.ts"],
      "@einfach-agent/core/*": ["packages/agent-core/src/*"],
      "@einfach-agent/host-node": ["packages/host-node/src/index.ts"],
      "@einfach-agent/observability-idb": ["packages/observability-idb/src"],
      "@einfach-agent/observability-sqlite": ["packages/observability-sqlite/src"],
      "@einfach-agent/persistence-idb": ["packages/persistence-idb/src"],
      "@einfach-agent/persistence-sqlite": ["packages/persistence-sqlite/src"],
      "@einfach-agent/react-plugin": ["packages/agent-react/src/index.ts"],
      "@einfach-agent/subagents": ["packages/subagents/src"],
      "@einfach-agent/tools": ["tools/standard/src/index.ts"],
      "@einfach-agent/tools-shell": ["tools/shell/src/index.ts"],
      "@einfach-agent/tools-interaction": ["tools/interaction/src/index.ts"],
      "@einfach-agent/tools-vision": ["tools/vision/src/index.ts"],
      "@einfach-agent/tools-fs": ["tools/fs/src/index.ts"],
      "@einfach-agent/tools-planning": ["tools/planning/src/index.ts"],
      "@einfach-agent/tools-skills": ["tools/skills/src/index.ts"],
      "@einfach-agent/tools-agents": ["tools/agents/src/index.ts"],
      "@einfach-agent/tools-mcp": ["tools/mcp/src/index.ts"],
      "@einfach-agent/browser-agent": ["browser-agent/agent/src/index.ts"],
      "@einfach-agent/browser-agent-ui": ["browser-agent/ui/src/index.ts"],
      "@einfach-agent/tools-browser-page": ["browser-agent/tools/page/src/index.ts"],
      "@einfach-agent/tools-browser-api": ["browser-agent/tools/api/src/index.ts"],
      "@einfach-agent/tools-browser-dom": ["browser-agent/tools/dom/src/index.ts"],
      "@einfach-agent/tools-browser-ocr": ["browser-agent/tools/ocr/src/index.ts"],
      "@einfach-agent/tools-browser-network": ["browser-agent/tools/network/src/index.ts"]
    }
  },
  "include": ["apps/web/src", "apps/cli/src", "apps/server/src", "packages/*/src", "tools/*/src", "browser-agent/*/src", "browser-agent/tools/*/src", "browser-agent/examples/*/src"]
}
