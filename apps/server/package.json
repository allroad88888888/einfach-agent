{
  "name": "@einfach-agent/server",
  "version": "0.1.0",
  "description": "Self-hosted web host for the Einfach Agent runtime: one local HTTP server that serves the bundled web UI and executes shell, file and Git work on the machine it runs on.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allroad88888888/einfach-agent.git",
    "directory": "apps/server"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/main.js",
  "bin": {
    "einfach-agent": "./bin/einfach-agent.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup && node scripts/embed-web-dist.mjs"
  },
  "dependencies": {
    "@einfach-agent/core": "workspace:*",
    "@einfach-agent/host-node": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.0.15"
  }
}
