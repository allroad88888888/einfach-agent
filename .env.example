# Fill this locally. Browser-side VITE_* values are exposed to the built client.
VITE_DEEPSEEK_API_KEY=

# Optional. If unset, a non-empty VITE_DEEPSEEK_API_KEY automatically enables DeepSeek.
VITE_AGENT_MODEL_PROVIDER=deepseek

# Official DeepSeek OpenAI-compatible API defaults.
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com
VITE_DEEPSEEK_MODEL=deepseek-v4-pro
